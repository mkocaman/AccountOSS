Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "documentType": "Payment",
  "template": "{PREFIX}-{YEAR}-{SEQUENCE}",
  "prefix": "PAY",
  "includeYear": true,
  "yearFormat": "YYYY",
  "includeMonth": false,
  "sequenceLength": 4,
  "startingNumber": 1,
  "resetFrequency": 1
}

