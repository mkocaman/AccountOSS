Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "entryDate": "2025-10-18",
  "description": "Fatura satışı - Müşteri A",
  "lines": [
    {
      "accountId": "{{receivablesAccountId}}",
      "debitAmount": 12000,
      "creditAmount": 0,
