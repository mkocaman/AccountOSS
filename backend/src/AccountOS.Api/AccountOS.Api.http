DELETE {{baseUrl}}/languages/TR_LANGUAGE_ID
Authorization: Bearer {{accessToken}}
# Expected: "Varsayılan dil silinemez"

### ===============================
### TENANT USER LIMIT MANAGEMENT
### ===============================

### 21. Get Company (Check User Limit)
GET {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{accessToken}}
# Response includes:
# {
#   "maxUsers": 5,
#   "currentUserCount": 3,
#   "isUserLimitReached": false
# }

### 22. Update Company Max Users (Owner Only)
PUT {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "id": "{{companyId}}",
  "name": "Test Company",
  "maxUsers": 10
}

### 23. Invite User - Should Succeed (Under Limit)
POST {{baseUrl}}/companies/invite
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "companyId": "{{companyId}}",
  "email": "newuser@example.com",
  "role": "User"
}

### 24. Try to Reduce MaxUsers Below Current Count (Should Fail)
PUT {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "id": "{{companyId}}",
  "name": "Test Company",
  "maxUsers": 2
}
# Expected: "Maksimum kullanıcı sayısı mevcut kullanıcı sayısından (5) az olamaz"

### 25. Invite User When Limit Reached (Should Fail)
POST {{baseUrl}}/companies/invite
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "companyId": "{{companyId}}",
  "email": "limitexceeded@example.com",
  "role": "User"
}
# Expected: "Kullanıcı limiti aşıldı! Maksimum: 5, Mevcut: 5"

### ===============================
### STOCK MANAGEMENT (FIFO)
### ===============================

### 26. Add Stock - Purchase 1 (100 @ 150 TRY)
POST {{baseUrl}}/stock/add
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 100,
  "unitCost": 150.00,
  "currency": "TRY",
  "referenceType": "Purchase",
  "description": "İlk alış - 100 adet @ 150 TRY"
}

### 27. Add Stock - Purchase 2 (50 @ 180 TRY)
POST {{baseUrl}}/stock/add
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 50,
  "unitCost": 180.00,
  "currency": "TRY",
  "referenceType": "Purchase",
  "description": "İkinci alış - 50 adet @ 180 TRY (daha pahalı)"
}

### 28. Remove Stock - Sales (FIFO Test - 75 units)
# Expected FIFO Cost: 75 × 150 = 11,250 TRY
# Expected Layer 1 Remaining: 25, Layer 2 Remaining: 50
POST {{baseUrl}}/stock/remove
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 75,
  "referenceType": "Sales",
  "description": "Satış - FIFO testi (en eski 100'den 75, kalan 25)"
}

### 29. Get Stock Layers (Active Only)
GET {{baseUrl}}/stock/layers?productId={{productId}}&activeOnly=true
Authorization: Bearer {{accessToken}}

### 30. Get Stock Layers (All - Including Consumed)
GET {{baseUrl}}/stock/layers?productId={{productId}}&activeOnly=false
Authorization: Bearer {{accessToken}}

### 31. Get Stock Movements
GET {{baseUrl}}/stock/movements?productId={{productId}}
Authorization: Bearer {{accessToken}}

### 32. Get Stock Movements (Date Range)
GET {{baseUrl}}/stock/movements?productId={{productId}}&startDate=2025-01-01&endDate=2025-12-31
Authorization: Bearer {{accessToken}}

### 33. Test Multi-Layer FIFO Consumption (50 units)
# Expected: Consume 25 from Layer 1, 25 from Layer 2
# Expected FIFO Cost: (25 × 150) + (25 × 180) = 8,250 TRY
POST {{baseUrl}}/stock/remove
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 50,
  "referenceType": "Sales",
  "description": "Multi-layer FIFO test"
}

### 34. Test Insufficient Stock Error
POST {{baseUrl}}/stock/remove
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 1000,
  "referenceType": "Sales",
  "description": "Bu hata vermeli - yetersiz stok"
}

### 35. Add Stock - Adjustment (Sayım Fazlası)
POST {{baseUrl}}/stock/add
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 10,
  "unitCost": 0,
  "currency": "TRY",
  "referenceType": "Adjustment",
  "description": "Sayım fazlası ekleme"
}

### 36. Check Product Stock Quantity
GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{accessToken}}

