{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build --mode production",
    "build:staging": "tsc && vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 100",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "analyze": "vite-bundle-visualizer",
    "clean": "rm -rf dist node_modules",
    "prebuild": "npm run type-check"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/plots": "^2.6.6",
    "@ant-design/pro-card": "^2.10.0",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/pro-descriptions": "^2.6.10",
    "@ant-design/pro-form": "^2.32.0",
    "@ant-design/pro-layout": "^7.22.7",
    "@ant-design/pro-list": "^2.6.10",
    "@ant-design/pro-skeleton": "^2.2.1",
    "@ant-design/pro-table": "^3.21.0",
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/signalr": "^9.0.6",
    "@tanstack/react-query": "^5.90.5",
    "antd": "^5.27.5",
    "axios": "^1.12.2",
    "dayjs": "^1.11.18",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lodash": "^4.17.21",
    "rc-resize-observer": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.1.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12",
    "zustand": "^5.0.8",
    "vite-plugin-pwa": "^0.17.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.6.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "msw": "^2.11.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "workbox-window": "^7.0.0",
    "@sentry/react": "^8.15.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
